# --- Gemini ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Telegram ---
# 1. Message @BotFather on Telegram, run /newbot, copy the token it gives you
# 2. Send any message to your new bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} value — that's your chat id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Market data source ---
# Primary: Apify actor (structured JSON, no HTML scraping needed).
# Get a token: Apify Console → Settings → Integrations → "Personal API tokens".
# Leave APIFY_TOKEN blank to skip Apify and use the scraper fallback below instead.
APIFY_TOKEN=
APIFY_ACTOR_ID=mansalabs/african-stock-market-data
