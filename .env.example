# --- Gemini ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Telegram ---
# 1. Message @BotFather on Telegram, run /newbot, copy the token it gives you
# 2. Send any message to your new bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} value — that's your chat id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Market data source ---
# See README.md — point this at a licensed/paid NSE data endpoint if you have one.
# The included scraper is a best-effort fallback for personal use only.
MARKET_DATA_URL=https://afx.kwayisi.org/nse/

# --- Security ---
# Optional but recommended once deployed: any random string. When set,
# /api/cron/briefing only accepts requests carrying this as a Bearer token.
# Vercel sends it automatically on scheduled Cron calls once this is set
# as a Vercel env var — see README.md.
CRON_SECRET=
